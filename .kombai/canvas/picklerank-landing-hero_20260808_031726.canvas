    "var_4dd63cf66677": {
      "type": "variant",
      "label": "PickleRank First-Visit Hero",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto+Condensed:wght@400;500;600;700;800;900&display=swap');\n\n  :root {\n    --page: #000000;\n    --lime: #a3e635;\n    --white: #ffffff;\n    --slate: #94a3b8;\n    --line: rgba(255, 255, 255, 0.16);\n    --faint: rgba(255, 255, 255, 0.06);\n  }\n\n  .picklerank-hero {\n    min-height: 100vh;\n    overflow: hidden;\n    position: relative;\n    isolation: isolate;\n    background: var(--page);\n    color: var(--white);\n    font-family: 'Inter', system-ui, sans-serif;\n  }\n\n  .picklerank-hero::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    z-index: -2;\n    opacity: 0.45;\n    background-image: linear-gradient(118deg, transparent 0 48%, var(--faint) 48.1% 48.25%, transparent 48.35%), linear-gradient(28deg, transparent 0 70%, rgba(255,255,255,0.035) 70.1% 70.25%, transparent 70.35%);\n    background-size: 145px 145px, 210px 210px;\n    transform: skewY(-7deg) scale(1.18);\n    transform-origin: center;\n  }\n\n  .picklerank-hero::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    z-index: -1;\n    pointer-events: none;\n    background: linear-gradient(90deg, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.7) 38%, rgba(0,0,0,0.08) 72%, rgba(0,0,0,0.42) 100%);\n  }\n\n  .hero-nav,\n  .hero-main {\n    width: min(100% - 112px, 1328px);\n    margin: 0 auto;\n  }\n\n  .hero-nav {\n    position: relative;\n    z-index: 5;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    min-height: 98px;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .hero-brand {\n    display: inline-flex;\n    align-items: center;\n    gap: 14px;\n    color: var(--white);\n    font-family: 'Roboto Condensed', sans-serif;\n    font-size: 1.18rem;\n    font-weight: 900;\n    letter-spacing: -0.04em;\n    text-decoration: none;\n  }\n\n  .hero-brand img {\n    width: 46px;\n    height: 46px;\n    border-radius: 50%;\n    background: var(--page);\n    object-fit: cover;\n    object-position: center;\n  }\n\n  .hero-auth {\n    display: flex;\n    align-items: center;\n    gap: 26px;\n    font-size: 0.73rem;\n    font-weight: 800;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n\n  .hero-auth a {\n    color: var(--white);\n    text-decoration: none;\n    transition: color 180ms ease;\n  }\n\n  .hero-auth a:hover {\n    color: var(--lime);\n  }\n\n  .hero-register {\n    display: inline-flex;\n    align-items: center;\n    min-height: 44px;\n    padding: 0 19px;\n    border: 1px solid var(--lime);\n    border-radius: 999px;\n    background: var(--lime);\n    color: #0f172a !important;\n    transition: transform 180ms ease, box-shadow 180ms ease;\n  }\n\n  .hero-register:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 8px 0 rgba(163, 230, 53, 0.17);\n  }\n\n  .hero-main {\n    position: relative;\n    display: grid;\n    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);\n    align-items: center;\n    min-height: calc(100vh - 98px);\n    padding: 76px 0 86px;\n  }\n\n  .hero-copy {\n    position: relative;\n    z-index: 3;\n    padding: 20px 0 30px 34px;\n  }\n\n  .hero-copy::before {\n    content: '';\n    position: absolute;\n    top: 24px;\n    left: 0;\n    width: 5px;\n    height: 116px;\n    background: var(--lime);\n  }\n\n  .hero-kicker {\n    margin: 0 0 24px;\n    color: var(--lime);\n    font-size: 0.72rem;\n    font-weight: 800;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n  }\n\n  .hero-title {\n    max-width: 760px;\n    margin: 0;\n    font-family: 'Roboto Condensed', sans-serif;\n    font-size: clamp(4.8rem, 7.1vw, 8.6rem);\n    font-weight: 900;\n    letter-spacing: -0.075em;\n    line-height: 0.82;\n    text-transform: uppercase;\n  }\n\n  .hero-title .solid {\n    display: block;\n    color: var(--white);\n  }\n\n  .hero-title .outline {\n    display: block;\n    margin-left: 0.07em;\n    color: transparent;\n    -webkit-text-stroke: 2px var(--lime);\n    text-stroke: 2px var(--lime);\n  }\n\n  .hero-description {\n    max-width: 390px;\n    margin: 32px 0 0;\n    color: var(--slate);\n    font-size: 1rem;\n    line-height: 1.65;\n  }\n\n  .hero-actions {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n    margin-top: 36px;\n  }\n\n  .hero-cta {\n    display: inline-flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 24px;\n    min-width: 205px;\n    min-height: 62px;\n    padding: 0 21px 0 24px;\n    border: 1px solid var(--lime);\n    border-radius: 5px;\n    background: var(--lime);\n    color: #0f172a;\n    font-size: 0.82rem;\n    font-weight: 900;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    text-decoration: none;\n    transition: transform 180ms ease, box-shadow 180ms ease;\n  }\n\n  .hero-cta:hover {\n    transform: translateY(-3px);\n    box-shadow: 0 10px 0 rgba(163, 230, 53, 0.16);\n  }\n\n  .hero-cta i {\n    display: inline-flex;\n    width: 22px;\n    height: 22px;\n    align-items: center;\n    justify-content: center;\n    font-size: 1.2rem;\n    line-height: 1;\n    transition: transform 180ms ease;\n  }\n\n  .hero-cta:hover i {\n    transform: translateX(5px);\n  }\n\n  .hero-sublabel {\n    color: var(--slate);\n    font-size: 0.66rem;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n  }\n\n  .hero-media-column {\n    position: relative;\n    min-height: 620px;\n    margin-right: -62px;\n  }\n\n  .hero-media-frame {\n    position: absolute;\n    inset: 0 0 0 50px;\n    overflow: hidden;\n    clip-path: polygon(16% 0, 100% 0, 88% 100%, 0 100%);\n    border-left: 2px solid var(--lime);\n    background: #111827;\n    transform: rotate(1.5deg);\n    transition: transform 500ms ease;\n  }\n\n  .hero-media-frame:hover {\n    transform: rotate(0deg) scale(1.015);\n  }\n\n  .hero-media-frame::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(145deg, rgba(163, 230, 53, 0.08), transparent 35%, rgba(0,0,0,0.5));\n    mix-blend-mode: screen;\n    pointer-events: none;\n  }\n\n  .hero-media-frame img {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    object-position: 50% 44%;\n    filter: saturate(0.86) contrast(1.12) brightness(0.72);\n    transform: scale(1.04);\n    transition: transform 800ms ease, filter 500ms ease;\n  }\n\n  .hero-media-frame:hover img {\n    transform: scale(1.09);\n    filter: saturate(1) contrast(1.12) brightness(0.8);\n  }\n\n  .hero-media-label {\n    position: absolute;\n    right: 58px;\n    bottom: 28px;\n    z-index: 2;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    color: var(--white);\n    font-size: 0.68rem;\n    font-weight: 800;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n  }\n\n  .hero-media-label::before {\n    content: '';\n    width: 34px;\n    height: 2px;\n    background: var(--lime);\n  }\n\n  .hero-side-note {\n    position: absolute;\n    top: 52px;\n    right: 14px;\n    color: rgba(255,255,255,0.52);\n    font-size: 0.62rem;\n    font-weight: 700;\n    letter-spacing: 0.2em;\n    writing-mode: vertical-rl;\n    text-transform: uppercase;\n  }\n\n  .hero-cross {\n    position: absolute;\n    width: 14px;\n    height: 14px;\n    opacity: 0.42;\n  }\n\n  .hero-cross::before,\n  .hero-cross::after {\n    content: '';\n    position: absolute;\n    background: var(--white);\n  }\n\n  .hero-cross::before {\n    top: 6px;\n    left: 0;\n    width: 14px;\n    height: 1px;\n  }\n\n  .hero-cross::after {\n    top: 0;\n    left: 6px;\n    width: 1px;\n    height: 14px;\n  }\n\n  .hero-cross.one { top: 23%; left: 48%; }\n  .hero-cross.two { right: 7%; bottom: 18%; transform: rotate(45deg); opacity: 0.25; }\n\n  @media (max-width: 980px) {\n    .hero-nav,\n    .hero-main { width: min(100% - 48px, 760px); }\n    .hero-main { grid-template-columns: 1fr; padding-top: 56px; }\n    .hero-copy { padding-left: 24px; }\n    .hero-media-column { min-height: 440px; margin: 34px -22px 0; }\n    .hero-media-frame { inset-left: 18px; }\n    .hero-side-note { display: none; }\n  }\n\n  @media (max-width: 560px) {\n    .hero-nav,\n    .hero-main { width: min(100% - 32px, 460px); }\n    .hero-nav { min-height: 78px; }\n    .hero-brand { font-size: 1rem; }\n    .hero-brand img { width: 38px; height: 38px; }\n    .hero-auth { gap: 12px; font-size: 0.62rem; }\n    .hero-register { min-height: 38px; padding: 0 13px; }\n    .hero-main { min-height: auto; padding: 64px 0 56px; }\n    .hero-copy { padding: 0 0 18px 20px; }\n    .hero-copy::before { top: 10px; width: 3px; height: 82px; }\n    .hero-kicker { margin-bottom: 20px; }\n    .hero-title { font-size: clamp(3.35rem, 15vw, 5.1rem); }\n    .hero-title .outline { -webkit-text-stroke-width: 1px; }\n    .hero-description { max-width: 310px; margin-top: 24px; font-size: 0.9rem; }\n    .hero-actions { align-items: flex-start; flex-direction: column; gap: 14px; margin-top: 28px; }\n    .hero-media-column { min-height: 330px; margin: 26px -16px 0; }\n    .hero-media-frame { inset: 0 0 0 18px; clip-path: polygon(14% 0, 100% 0, 89% 100%, 0 100%); }\n    .hero-media-label { right: 26px; bottom: 18px; font-size: 0.56rem; }\n  }\n</style>\n<div class=\"picklerank-hero\" data-kid=\"1\" data-name=\"pickleball platform hero section\">\n    <header class=\"hero-nav\" data-kid=\"1-1\" data-name=\"navigation bar\">\n        <a aria-label=\"PickleRank home\" class=\"hero-brand\" data-kid=\"1-1-1\" data-name=\"brand identity logo and name\" href=\"#\">\n            <img alt=\"PickleRank logo\" data-kid=\"1-1-1-1\" data-name=\"pickleball brand logo icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/pickle-rank-logo.png\"/>\n            <span data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                PickleRank\n            </span>\n        </a>\n        <nav aria-label=\"Authentication\" class=\"hero-auth\" data-kid=\"1-1-2\" data-name=\"user authentication links\">\n            <a data-kid=\"1-1-2-1\" data-name=\"login navigation link\" href=\"#login\">\n                Log In\n            </a>\n            <a class=\"hero-register\" data-kid=\"1-1-2-2\" data-name=\"register navigation button\" href=\"#register\">\n                Register\n            </a>\n        </nav>\n    </header>\n    <main class=\"hero-main\" data-kid=\"1-2\" data-name=\"main hero content area\">\n        <section class=\"hero-copy\" data-kid=\"1-2-1\" data-name=\"hero copy and call to action section\" data-reveal=\"hero-copy\">\n            <p class=\"hero-kicker\" data-kid=\"1-2-1-1\" data-name=\"hero kicker label\">\n                Pickleball ranking system · 01\n            </p>\n            <h1 class=\"hero-title\" data-kid=\"1-2-1-2\" data-name=\"hero main headline\">\n                <span class=\"solid\" data-kid=\"1-2-1-2-1\" data-name=\"main headline solid text\">\n                    Own the court.\n                </span>\n                <span class=\"outline\" data-kid=\"1-2-1-2-2\" data-name=\"main headline outline text\">\n                    Climb the ladder.\n                </span>\n            </h1>\n            <p class=\"hero-description\" data-kid=\"1-2-1-3\" data-name=\"hero description text\">\n                Track every game. Rank every rally. Turn your next point into a higher place on the ladder.\n            </p>\n            <div class=\"hero-actions\" data-kid=\"1-2-1-4\" data-name=\"hero call to action group\">\n                <a class=\"hero-cta\" data-kid=\"1-2-1-4-1\" data-name=\"primary call to action button\" href=\"#start\">\n                    Let's Start\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-2-1-4-1-1\" data-name=\"arrow right icon\">\n                    </i>\n                </a>\n                <span class=\"hero-sublabel\" data-kid=\"1-2-1-4-2\" data-name=\"call to action sublabel\">\n                    Build your ladder\n                </span>\n            </div>\n        </section>\n        <section aria-label=\"Pickleball action feature\" class=\"hero-media-column\" data-kid=\"1-2-2\" data-name=\"hero visual media column\">\n            <div class=\"hero-media-frame\" data-kid=\"1-2-2-1\" data-motion-ready=\"slow-drift\" data-name=\"hero media image frame\">\n                <img alt=\"Pickleball player mid-swing on an outdoor court, photographed by eedgar ivann on Unsplash\" data-kid=\"1-2-2-1-1\" data-name=\"hero featured pickleball image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1756477558468-b3e485757470?auto=format&w=1200&q=80&fit=crop\"/>\n                <span class=\"hero-media-label\" data-kid=\"1-2-2-1-2\" data-name=\"hero media label\">\n                    01 / Play the point\n                </span>\n            </div>\n            <span class=\"hero-side-note\" data-kid=\"1-2-2-2\" data-name=\"hero side decorative note\">\n                Ranking system / 2026\n            </span>\n        </section>\n    </main>\n    <span aria-hidden=\"true\" class=\"hero-cross one\" data-kid=\"1-3\" data-name=\"decorative cross icon one\">\n    </span>\n    <span aria-hidden=\"true\" class=\"hero-cross two\" data-kid=\"1-4\" data-name=\"decorative cross icon two\">\n    </span>\n</div>\n<link data-kid=\"2\" data-name=\"tabler icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n",
